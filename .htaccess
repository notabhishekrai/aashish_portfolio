ErrorDocument 404 /404.php

# Don't let the server list directory contents for folders with no index
# file (assets/images, etc.)
Options -Indexes

RewriteEngine On

# Block .git/ entirely — some Git-deploy setups leave it in the served
# directory, and the dotfile FilesMatch below only matches basenames,
# not directory path segments.
RewriteRule ^\.git/ - [F,L]

# Force HTTPS. The redirect target is pinned to the canonical domain rather
# than built from %{HTTP_HOST} — that reflects the client-supplied Host
# header unsanitized, which on a misconfigured/catch-all vhost lets a
# spoofed Host header steer the redirect. Update this if the domain changes.
RewriteCond %{HTTPS} off
RewriteRule ^ https://aashishrai.info.np%{REQUEST_URI} [L,R=301]

# Deny access to dotfiles (.env, .git, etc.)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Defense-in-depth response headers. No CSP here -- pages rely on inline
# style="" attributes throughout and a Google Fonts @import in style.css,
# so a correct script/style-src policy needs hands-on browser verification
# rather than a guess baked into ops config.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
